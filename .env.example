# Royal Hair Wigs — Invoice Maker Environment Variables
# Copy this file to .env.local for local development or configure in Vercel Project Settings.

# Authentication (Server-Side Direct Login)
AUTH_USERNAME=royalinvoice
AUTH_PASSWORD=Royal#Orbit@42647!

# Session Security (JWT Signing Secret - Minimum 32 characters)
# Generate one with: openssl rand -base64 32
SESSION_SECRET=royal-hair-wigs-production-session-secret-key-change-me-in-prod-2026

# Database Persistence (Optional for Remote Turso / LibSQL on Vercel)
# If omitted, local server-side SQLite is used (data/invoices.db locally or /tmp/invoices.db on Vercel).
# For permanent cross-instance persistence on serverless Vercel, supply your free Turso credentials:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
